#ifndef _VERSION_H
#define _VERSION_H

#cmakedefine PROJECT_NAME "@CMAKE_PROJECT_NAME@"
#cmakedefine PROJECT_VERSION "@CMAKE_PROJECT_VERSION@"
#cmakedefine PROJECT_VERSION_MAJOR "@CMAKE_PROJECT_VERSION_MAJOR@"
#cmakedefine PROJECT_VERSION_MINOR "@CMAKE_PROJECT_VERSION_MINOR@"
