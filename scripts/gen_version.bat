@echo off
setlocal EnableDelayedExpansion
rem Windows version of scripts/gen_version.sh
rem Freeze git info into version_git.h so builds work without a .git directory.
rem stdout prints only GIT_BRANCH/GIT_COMMIT/GIT_COMMIT_TIME (for CMake or build
rem scripts to parse); progress messages go to stderr.

rem PRJ_DIR: parent directory of this script
for %%I in ("%~dp0..") do set "PRJ_DIR=%%~fI"
set "OUT=%PRJ_DIR%\version_git.h"
set "TMP_OUT=%TEMP%\version_git.h.%RANDOM%.tmp"

rem Always call git via GIT_ARGS: safe.directory avoids "detected dubious
rem ownership" (git 2.35.2+, common for mounted/synced directories)
set "GIT_ARGS=-c "safe.directory=%PRJ_DIR%" -C "%PRJ_DIR%""

set "branch_name="
set "commit_id="
set "commit_time="

rem NOTE: "--format^=" must escape the "=", otherwise for /f splits the argument
for /f "usebackq delims=" %%A in (`git %GIT_ARGS% rev-parse --abbrev-ref HEAD 2^>nul`) do set "branch_name=%%A"
for /f "usebackq delims=" %%A in (`git %GIT_ARGS% rev-parse --short HEAD 2^>nul`) do set "commit_id=%%A"
for /f "usebackq delims=" %%A in (`git %GIT_ARGS% log -1 --format^=%%cI 2^>nul`) do set "commit_time=%%A"

rem mark commit as -dirty when there are local changes
if defined commit_id (
    git %GIT_ARGS% diff --quiet --ignore-submodules HEAD >nul 2>nul
    if errorlevel 1 set "commit_id=!commit_id!-dirty"
)

set "FALLBACK="
if not defined branch_name set "FALLBACK=1"
if not defined commit_id set "FALLBACK=1"

rem No git info: keep the existing file (synced source dir without .git) and
rem restore the values from it
if defined FALLBACK if exist "%OUT%" (
    call :restore "%OUT%" branch_name GIT_BRANCH
    call :restore "%OUT%" commit_id GIT_COMMIT
    call :restore "%OUT%" commit_time GIT_COMMIT_TIME
    echo No git info found, keeping existing %OUT% 1>&2
    echo GIT_BRANCH=!branch_name!
    echo GIT_COMMIT=!commit_id!
    echo GIT_COMMIT_TIME=!commit_time!
    exit /b 0
)

if not defined branch_name set "branch_name=unknown"
if not defined commit_id set "commit_id=unknown"
if not defined commit_time set "commit_time=unknown"

rem Write to a temp file first (version_git.h must stay pure ASCII: the project
rem compiles with /utf-8)
(
echo // Code generated by scripts/gen_version.bat. DO NOT EDIT.
echo // Frozen git info for builds without a .git directory.
echo #ifndef VERSION_GIT_H
echo #define VERSION_GIT_H
echo.
echo #define GIT_BRANCH "!branch_name!"
echo #define GIT_COMMIT "!commit_id!"
echo #define GIT_COMMIT_TIME "!commit_time!"
echo.
echo #endif // VERSION_GIT_H
) > "%TMP_OUT%"

rem Do not rewrite the file when content is unchanged, to avoid pointless rebuilds
fc /b "%TMP_OUT%" "%OUT%" >nul 2>nul
if errorlevel 1 (
    move /y "%TMP_OUT%" "%OUT%" >nul
    echo Written %OUT%: !branch_name! !commit_id! 1>&2
) else (
    del /q "%TMP_OUT%"
    echo Git info unchanged: !branch_name! !commit_id! 1>&2
)

echo GIT_BRANCH=!branch_name!
echo GIT_COMMIT=!commit_id!
echo GIT_COMMIT_TIME=!commit_time!
exit /b 0

rem Restore the quoted value of "#define KEY "value"" from an existing
rem version_git.h into the named variable
:restore
set "%~2="
for /f "usebackq delims=" %%A in (`findstr /b /c:"#define %~3 " "%~1"`) do (
    if not defined %~2 (
        for /f tokens^=2^ delims^=^" %%B in ("%%A") do set "%~2=%%B"
    )
)
if not defined %~2 set "%~2=unknown"
goto :eof
